# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# REAL GMAIL OTP DELIVERY (SMTP / Gmail App Password)
# Configure these in the AI Studio Secrets panel to send real OTP emails to any Gmail address:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-coaching-email@gmail.com"
SMTP_PASS="your-16-digit-google-app-password"
SMTP_FROM="5tar Coaching Manager <your-coaching-email@gmail.com>"

# REAL MOBILE SMS OTP DELIVERY (Fast2SMS for India OR Twilio)
# Option A: Fast2SMS (Indian Mobile Numbers)
FAST2SMS_API_KEY="your-fast2sms-api-key"

# Option B: Twilio SMS
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Optional external Supabase configuration (for external migration/deployment)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
